# Bravo Shadow — safe defaults only
BRAVO_STORAGE_BACKEND=memory

# Do not add production credentials here.
# PostgreSQL mode remains disabled until local migrations and integration tests pass.

# Somente PostgreSQL local isolado; mantenha vazio até aplicar e validar a migration.
# Nunca use URL/credenciais do banco de produção nesta branch.
BRAVO_DATABASE_URL=
